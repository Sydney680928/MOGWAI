
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<!-- Configuration de base -->
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>

		<!-- Versioning -->
		<Version>8.4.0</Version>
		<FileVersion>8.4.0.0</FileVersion>
		<AssemblyVersion>8.4.0.0</AssemblyVersion>

		<!-- Métadonnées minimales pour le package local -->
		<PackageId>MOGWAI</PackageId>
		<Authors>Stéphane Sibué</Authors>
		<Company>Stéphane Sibué</Company>
		<Product>MOGWAI</Product>
		<Description>MOGWAI - A modern RPN scripting language for industrial IoT automation.</Description>

		<!-- Copyright -->
		<Copyright>Copyright © 2015-2026 Stéphane Sibué</Copyright>

		<!-- LICENCE (Expression SPDX) -->
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		
		<!-- Liens projet -->
		<PackageProjectUrl>https://github.com/Sydney680928/mogwai</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Sydney680928/mogwai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Tags pour recherche -->
		<PackageTags>rpn;scripting;iot;automation;embedded;stack;forth;industrial</PackageTags>

		<!-- README -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Icone du package -->
		<PackageIcon>icon.png</PackageIcon>

		<!-- Release notes -->
		<PackageReleaseNotes>
		v8.4.0

		ADDED
		- !A sigil: evaluates the content of variable A directly (block, function, string, list, record). Equivalent to A eval but more efficient — the object never lands on the stack as an intermediate value. Silent no-op for non-executable types.
		- Circular reference detection: the runtime now raises an error (with full cycle chain) instead of looping indefinitely when !A triggers a recursive evaluation chain.
		- --> in-place pipeline operator: applies a list of transformations directly to a referenced variable — e.g. (->upper butfirst butlast) --> &amp;A. Fully transactional: a snapshot is restored automatically on error.

		CHANGED
		- AOT compatibility: the engine is now fully compatible with .NET Native AOT publishing. No behavioral changes.
		- ~13% speedup on the core execution loop.
		
		Full changelog: https://github.com/Sydney680928/mogwai/blob/main/CHANGELOG.md
		</PackageReleaseNotes>
			
		<!-- Pas de publication pour l'instant -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Symbols pour le debugging local -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!--<DebugType>embedded</DebugType>-->
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	</Project>