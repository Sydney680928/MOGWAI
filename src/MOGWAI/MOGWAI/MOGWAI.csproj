
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<!-- Configuration de base -->
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>

		<!-- Versioning -->
		<Version>8.6.0</Version>
		<FileVersion>8.6.0.0</FileVersion>
		<AssemblyVersion>8.6.0.0</AssemblyVersion>

		<!-- Métadonnées minimales pour le package local -->
		<PackageId>MOGWAI</PackageId>
		<Authors>Stéphane Sibué</Authors>
		<Company>Stéphane Sibué</Company>
		<Product>MOGWAI</Product>
		<Description>MOGWAI - A modern RPN scripting language for industrial IoT automation.</Description>

		<!-- Copyright -->
		<Copyright>Copyright © 2015-2026 Stéphane Sibué</Copyright>

		<!-- LICENCE (Expression SPDX) -->
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		
		<!-- Liens projet -->
		<PackageProjectUrl>https://github.com/Sydney680928/mogwai</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Sydney680928/mogwai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Tags pour recherche -->
		<PackageTags>rpn;scripting;iot;automation;embedded;stack;forth;industrial</PackageTags>

		<!-- README -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Icone du package -->
		<PackageIcon>icon.png</PackageIcon>

		<!-- Release notes -->
		<PackageReleaseNotes>
			v8.6.0

			mogwai.assert — new assertion primitive. Accepts a boolean or a list (auto-evaluated). Raises MW.9 on failure with a display-only message; error.last returns MW.9. Raises MW.24 if a list pushes more than one value, MW.21 if the result is not boolean.

			Object-Oriented Programming : MOGWAI now supports a complete class system
			- class 'Name' do { ... }` defines a class with private: and public: sections.
			- Properties declared with a type sigil (e.g. .number, .string), initialized to empty.
			- Methods declared as named code blocks within a section.
			- Optional lifecycle hooks: onInit: (called on new) and onFree: (called on free).
			- new, creates an instance; each instance receives a unique internal handle (§N).
			- free, destroys an instance and invalidates all references to it.
			- self, automatically injected reference to the current instance inside any method.
			- className:, read-only public property available on every instance; returns the class name as a string.

			- MW.95, new error code raised when the reserved property className: is written to or declared in a class definition.

			Full changelog: https://github.com/Sydney680928/mogwai/blob/main/CHANGELOG.md
		</PackageReleaseNotes>
			
		<!-- Pas de publication pour l'instant -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Symbols pour le debugging local -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!--<DebugType>embedded</DebugType>-->
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	</Project>