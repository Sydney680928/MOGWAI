
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<!-- Configuration de base -->
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>

		<!-- Versioning -->
		<Version>8.1.0</Version>
		<FileVersion>8.1.0.0</FileVersion>
		<AssemblyVersion>8.1.0.0</AssemblyVersion>

		<!-- Métadonnées minimales pour le package local -->
		<PackageId>MOGWAI</PackageId>
		<Authors>Stéphane Sibué</Authors>
		<Company>Stéphane Sibué</Company>
		<Product>MOGWAI</Product>
		<Description>MOGWAI - A modern RPN scripting language for industrial IoT automation.</Description>

		<!-- Copyright -->
		<Copyright>Copyright © 2015-2026 Stéphane Sibué</Copyright>

		<!-- LICENCE (Expression SPDX) -->
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		
		<!-- Liens projet -->
		<PackageProjectUrl>https://github.com/Sydney680928/mogwai</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Sydney680928/mogwai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Tags pour recherche -->
		<PackageTags>rpn;scripting;iot;automation;embedded;stack;forth;industrial</PackageTags>

		<!-- README -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Icone du package -->
		<PackageIcon>icon.png</PackageIcon>

		<!-- Release notes -->
		<PackageReleaseNotes>
			8.1.0

			New primitive: +/- to negate a number (e.g. 5 +/- ==> -5)
			New error: OperationNotSupportedError (MW.7)

			foreach now supports a transform mode:
			(1 2 3 4) foreach 'item' transform { item 2 * }       ==> (2 4 6 8)
			(1 2 3 4) foreach 'item' transform { item 2 * ->str } ==> ("2" "4" "6" "8")

			MOGBaseItems and MOGRecord now expose typed helper methods (AddString, AddNumber, AddName... / SetString, SetNumber, SetName...) that simplify object creation without requiring an explicit Engine reference.

			Changed: get on MOGRecord now returns MOGNull instead of throwing when key is not found.
			Changed: keys named after reserved words are now allowed.

			Fixed: bug with MOGRecord AutoEval capability.
		</PackageReleaseNotes>
			
		<!-- Pas de publication pour l'instant -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Symbols pour le debugging local -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!--<DebugType>embedded</DebugType>-->
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	</Project>