
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		
		<!-- Configuration de base -->
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<OutputType>Library</OutputType>

		<!-- Versioning -->
		<Version>8.4.0</Version>
		<FileVersion>8.4.0.0</FileVersion>
		<AssemblyVersion>8.4.0.0</AssemblyVersion>

		<!-- Métadonnées minimales pour le package local -->
		<PackageId>MOGWAI</PackageId>
		<Authors>Stéphane Sibué</Authors>
		<Company>Stéphane Sibué</Company>
		<Product>MOGWAI</Product>
		<Description>MOGWAI - A modern RPN scripting language for industrial IoT automation.</Description>

		<!-- Copyright -->
		<Copyright>Copyright © 2015-2026 Stéphane Sibué</Copyright>

		<!-- LICENCE (Expression SPDX) -->
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		
		<!-- Liens projet -->
		<PackageProjectUrl>https://github.com/Sydney680928/mogwai</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Sydney680928/mogwai</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<!-- Tags pour recherche -->
		<PackageTags>rpn;scripting;iot;automation;embedded;stack;forth;industrial</PackageTags>

		<!-- README -->
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Icone du package -->
		<PackageIcon>icon.png</PackageIcon>

		<!-- Release notes -->
		<PackageReleaseNotes>
		v8.3.0

		ADDED
		- Variable reference support with &amp;varname notation. In-place mutation without pushing a copy onto the stack. Significant performance gain on large lists, records, data, and strings. Supported primitives: +, set, get, butfirst, butlast, last, first, sub, size.
		- Host function detection at parse time, avoiding delegate dispatch overhead at runtime.
		- New char-> primitive: returns the ASCII code of a single string character.
		- Explicit static variable access with @varname notation. Resolved at parse time, eliminating runtime lookup overhead.
		- foreach loop now supports iteration over string characters.

		CHANGED
		- Dictionary lookups now use TryGetValue instead of ContainsKey + retrieval (all runtime dictionaries).
		- Variable and function names must now start with a letter or underscore _.
		- Synchronous primitives refactored: spurious async/await Task.CompletedTask replaced with Task.FromResult(). No behavioral change.
		- Removed systematic primitive cloning during execution.
		- Removed all LINK calls during execution.
		- Optimized primitive dictionaries for faster lookup.

		Full changelog: https://github.com/Sydney680928/mogwai/blob/main/CHANGELOG.md
		</PackageReleaseNotes>
			
		<!-- Pas de publication pour l'instant -->
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>

		<!-- Symbols pour le debugging local -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!--<DebugType>embedded</DebugType>-->
		
	</PropertyGroup>

	<ItemGroup>
		<None Include="Primitives\PrimitiveSTO.cs" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<PropertyGroup>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>

	</Project>