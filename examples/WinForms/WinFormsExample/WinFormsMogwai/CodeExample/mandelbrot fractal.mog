# Mandelbrot fractal in ascii output
mogwai.reset
console.clear
to 'bf_run' with [code: .string] do
{
    now -> 'begin'
    code size -> 'code_len'
    
    # Cellules BF : 30 000 octets à 0
    30000 repeat { 0 } 30000 ->data -> 'cells'
    0 -> 'cell_ptr'
    
    # Table de sauts initialisée à -1
    code_len repeat { -1 } code_len ->list -> 'jumps'
    # Pré-scan des brackets [ ] pour construire jumps
    ( ) -> 'bstack'
    0 -> 'i'
    while (i code_len <) do
    {
        &code i 1 sub -> 'instr'
        switch
        {
            (instr "[" ==) then
            {
                &bstack i +
            }
            (instr "]" ==) then
            {
                &bstack &bstack size 1 - get -> 'start_idx'
                &bstack butlast
                &jumps start_idx i set
                &jumps i start_idx set
            }
        }
        'i' ++
    }
    0 -> 'code_ptr'
    while (code_ptr code_len <) do
    {
        &code code_ptr 1 sub -> 'instr'
        switch
        {
            (instr ">" ==) then
            {
                'cell_ptr' ++
            }
            (instr "<" ==) then
            {
                if (cell_ptr 0 >) then
                {
                    'cell_ptr' --
                }
            }
            (instr "+" ==) then
            {
                &cells cell_ptr get 1 + -> 'v'
                &cells cell_ptr v set
            }
            (instr "-" ==) then
            {
                &cells cell_ptr get 1 - -> 'v'
                &cells cell_ptr v set
            }
            (instr "." ==) then
            {
                &cells cell_ptr get ->char ??
            }
            (instr "[" ==) then
            {
                if (&cells cell_ptr get 0 ==) then
                {
                    &jumps code_ptr get -> 'code_ptr'
                }
            }
            (instr "]" ==) then
            {
                if (&cells cell_ptr get 0 !=) then
                {
                    &jumps code_ptr get -> 'code_ptr'
                }
            }
        }
        'code_ptr' ++
    }

	# Execution time
    
    now begin - ->durations -> 'durations'
    " " ?
    "Execution time: {! durations totalMinutes: get} minutes" eval ?
}

# HELLO WORLD
# "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++." bf_run

