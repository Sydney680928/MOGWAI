# Mandelbrot fractal in ascii output
mogwai.resetconsole.clearto 'bf_run' with [code: .string] do{    now -> 'begin'    code size -> 'code_len'    # Cellules BF : 30 000 octets à 0    30000 repeat { 0 } 30000 ->data -> 'cells'    0 -> 'cell_ptr'    # Table de sauts initialisée à -1    code_len repeat { -1 } code_len ->list -> 'jumps'    # Conversion du code en liste de clés ASCII (une seule fois)    0 code_len 1 - for 'i' do    {        code i 1 sub char-> ->str ->key    }    code_len ->list -> 'code_keys'    # Pré-scan des brackets [ ] pour construire jumps    ( ) -> 'bstack'    0 code_len 1 - for 'i' do    {        &code_keys i get -> 'instr'        switch        {            (instr 91: ==) then            {                &bstack i +            }            (instr 93: ==) then            {                &bstack &bstack size 1 - get -> 'start_idx'                &bstack butlast                &jumps start_idx i set                &jumps i start_idx set            }        }    }    # Table de dispatch	[		9:  { }		10: { }		13: { }		32: { }		62: { 'cell_ptr' ++ }		60: { if (cell_ptr 0 >) then { 'cell_ptr' -- } }		43: { &cells cell_ptr get 1 + -> 'v'  &cells cell_ptr v set }		45: { &cells cell_ptr get 1 - -> 'v'  &cells cell_ptr v set }		46: { &cells cell_ptr get ->char ?? }		91: { if (&cells cell_ptr get 0 ==) then { &jumps code_ptr get -> 'code_ptr' } }		93: { if (&cells cell_ptr get 0 !=) then { &jumps code_ptr get -> 'code_ptr' } }	] -> 'dispatch'    # Boucle principale de l'interpréteur BF
    
	0 -> 'code_ptr'
	while (code_ptr code_len <) do
	{
	    &dispatch &code_keys code_ptr get get eval
	    'code_ptr' ++
	}    # Mesure du temps d'exécution    " " ?	"Execution time: " ??    now begin - ->duration ?}
# HELLO WORLD
# "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++." bf_run
