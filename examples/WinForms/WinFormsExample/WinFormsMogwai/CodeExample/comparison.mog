# Comparison operators

mogwai.reset
console.clear

10 -> 'x'
20 -> 'y'

if (x y <)  then { "10 is less than 20" ? }
if (y x >)  then { "20 is greater than 10" ? }

5 -> 'a'
if (a 5 ==) then { "a equals 5" ? }
if (x y !=) then { "x and y are different" ? }

10 -> 'b'
if (b 10 <=) then { "b is less than or equal to 10" ? }
if (b 10 >=) then { "b is greater than or equal to 10" ? }
