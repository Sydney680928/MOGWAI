# ex03_publish.mog
# Illustrer le pattern de reporting de progression depuis une tâche longue.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
}

onEvent 'TASK_DID_END' do
{
    "TASK DID END {! eventData}" eval ?
    "La tâche est terminée." ?
    "" ?
}

onEvent 'TASK_DID_PUBLISH' do
{
    "TASK DID PUBLISH {! eventData}" eval ?
    "Progression : {! eventData->message:}/5" eval ?
    "" ?
}

task 'T1' do 
{
    1 5 for 'i' do
    {
        2000 rand * 1000 + ->int wait
        i task.publish
    }

    500 wait

    [processed: 5 error: 0] task.setResult
}

task 'T1' start with empty

'T1' task.wait

"Programme terminé" ?
