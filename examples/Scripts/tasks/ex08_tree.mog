# ex08_tree.mog
# Illustrer la composition d'arbres de tâches : une tâche enfant peut elle-même créer et gérer des tâches enfants.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    DI
    "FROM MAIN" ?
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
    EI
}

onEvent 'TASK_DID_END' do
{
    DI
    "FROM MAIN" ?
    "TASK DID END {! eventData}" eval ?
    "La tâche est terminée." ?
    "" ?
    EI
}

task 'COORDINATOR' do 
{
    0 -> '$V1'
    0 -> '$V2'

    onEvent 'TASK_DID_START' do
    {
        DI
        "FROM COORDINATOR" ?
        "TASK DID START {! eventData}" eval ?
        "La tâche travaille..." ?
        "" ?
        EI
    }

    onEvent 'TASK_DID_END' do
    {
        DI

        "FROM COORDINATOR" ?
        "TASK DID END {! eventData}" eval ?
        "La tâche est terminée." ?
        "" ?

        switch 
        {
            (eventData->task: 'SUB1' ==) then { eventData->result: -> '$V1' }
            
            (eventData->task: 'SUB2' ==) then { eventData->result: -> '$V2' }
        }

        EI
    }

    task 'SUB1' do
    { 
        rand 3000 * ->int 2000 + -> 'v'
        
        v wait 
        v task.setResult
    }

    task 'SUB2' do
    { 
        rand 3000 * ->int 2000 + -> 'v'
        
        v wait 
        v task.setResult
    }

    'SUB1' task.start
    'SUB2' task.start

    ('SUB1' 'SUB2') task.join

    [! v1: $V1 v2: $V2 sum: {! $V1 $V2 +}] task.setResult
}

task 'COORDINATOR' start with null

'COORDINATOR' task.wait

"Programme terminé" ?
