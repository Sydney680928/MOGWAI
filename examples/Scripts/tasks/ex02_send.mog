# ex02_send.mog
# Show how the parent can send data to a running task.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    "TASK DID START {! eventData}" eval ?
    "Task is running..." ?
    "" ?

    post
    {
        ("Hello!" "How are you?" "I'm fine, thank you." "STOP") foreach 'message' do
        {
            task 'T1' send message
            1000 wait
        }
    }
}

onEvent 'TASK_DID_END' do
{
    "TASK DID END {! eventData}" eval ?
    "Task completed." ?
    "" ?
}

task 'T1' do 
{
    onEvent 'TASK_DID_RECEIVE' do
    {
        "TASK_DID_RECEIVE {! eventData}" eval ?
        " " ?

        if (eventData ->type .string ==) then
        {
            if (eventData "STOP" ==) then
            {
                'STOP_APP' flag.set
            }
        }
    }

    while ('STOP_APP' flag.isClear) do
    {
        # Passive wait: avoids consuming CPU unnecessarily
        200 wait
    }

    # Set the initial parameter as the task result
    message  task.setResult
}

task 'T1' start with empty

'T1' task.wait

"Program completed" ?
