# ex04_error.mog
# Montrer que les erreurs non gérées dans une tâche enfant ne font pas planter le parent.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    DI
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
    EI
}

onEvent 'TASK_DID_END' do
{
    DI
    "TASK DID END {! eventData}" eval ?
    "La tâche est terminée." ?
    "" ?
    EI
}

onEvent 'TASK_DID_PUBLISH' do
{
    DI
    "TASK DID PUBLISH {! eventData}" eval ?
    "La tâche {! eventData->task:} exécute l'opération {! eventData->message:}" eval ?
    "" ?
    EI
}

onEvent 'TASK_DID_FAIL' do
{
    DI
    "TASK DID FAIL {! eventData}" eval ?
    "La tâche s'est arrêtée suite à une erreur !" ?
    " " ?
    EI
}

task 'T1' do 
{
    10 1 for 'i' step -1 do
    {
        100 i / "0.00" ->format -> 'r'
        "100 / {! i} = {! r}" eval task.publish
        1000 wait
    }

    true task.setResult
}

task 'T2' do 
{
    4 0 for 'i' step -1 do
    {
        100 i / "0.00" ->format -> 'r'
        "100 / {! i} = {! r}" eval task.publish
        1000 wait
    }

    true task.setResult
}

task 'T1' start with empty

taxk 'T2' start with empty

('T1' 'T2') task.join

"Programme terminé" ?
