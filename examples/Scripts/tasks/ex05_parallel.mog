# ex05_parallel.mog
# Show how to parallelize independent operations and synchronize at the end.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    DI
    "TASK DID START {! eventData}" eval ?
    "Task is running..." ?
    "" ?
    EI
}

onEvent 'TASK_DID_END' do
{
    DI
    "TASK DID END {! eventData}" eval ?
    "Task {! eventData->task:} completed." eval ?
    "Return value = {! eventData->result:}" eval ?
    "" ?
    EI
}

task 'T1' do 
{
    1000 wait
    rand 100 * ->int task.setResult
}

task 'T2' do 
{
    2000 wait
    rand 100 * ->int task.setResult
}

task 'T3' do 
{
    3000 wait
    rand 100 * ->int task.setResult
}

task.list foreach 't' do 
{
	task t start with empty
}

task.list task.join

"Program completed" ?
