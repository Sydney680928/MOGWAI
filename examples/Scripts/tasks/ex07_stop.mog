# ex07_stop.mog
# Montrer comment le parent peut arrêter une tâche en cours d'exécution.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
}

onEvent 'TASK_DID_END' do
{
    "TASK DID END {! eventData}" eval ?
    "La tâche est terminée." ?
    "" ?
}

task 'T1' do 
{
    0 -> 'c'

    forever do 
    { 
        'c' ++
        c task.setResult

        rand 1000 * ->int 200 + wait
    }
}

task 'T1' start with empty

after 5000 do 
{
    'T1' task.stop
}

'T1' task.wait

"Programme terminé" ?
