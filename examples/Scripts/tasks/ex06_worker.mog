# ex06_worker.mog
# Illustrate the reusable worker pattern: a task defined once, restarted multiple times with different parameters.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    DI
    "TASK DID START {! eventData}" eval ?
    "Task is running..." ?
    "" ?
    EI
}

onEvent 'TASK_DID_END' do
{
    DI
    "TASK DID END {! eventData}" eval ?
    "Task {! eventData->task:} completed." eval ?
    "Return value = {! eventData->result:}" eval ?
    "" ?
    EI
}

# The worker is defined once and will be restarted as many times as needed

task 'WORKER' do 
{
    [wName: .string wMin: .number wMax: .number] ->params

    0 -> 'r'
    now -> 'begin'

    wMin wMax for 'i' do
    {
        i ->+ 'r'
        5 wait
    }

    now begin - ->duration ms: get -> 'd'
    
    [! Name: wName Value: r duration: d] task.setResult
}

task 'WORKER' start with [wName: "W1" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W2" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W3" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W4" wMin: 10 wMax: 50]
'WORKER' task.wait

"Program completed" ?
