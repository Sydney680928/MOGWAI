# ex06_worker.mog
# Illustrer le pattern de worker réutilisable : une tâche définie une fois, relancée plusieurs fois avec des paramètres différents.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    DI
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
    EI
}

onEvent 'TASK_DID_END' do
{
    DI
    "TASK DID END {! eventData}" eval ?
    "La tâche {! eventData->task:} est terminée." eval ?
    "Valeur de retour = {! eventData->result:}" eval ?
    "" ?
    EI
}

# Le worker est défini une seule fois et sera relancé autant de fois que nécessaire

task 'WORKER' do 
{
    [wName: .string wMin: .number wMax: .number] ->params

    0 -> 'r'
    now -> 'begin'

    wMin wMax for 'i' do
    {
        i ->+ 'r'
        5 wait
    }

    now begin - ->duration ms: get -> 'd'
    
    [! Name: wName Value: r duration: d] task.setResult
}

task 'WORKER' start with [wName: "W1" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W2" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W3" wMin: 10 wMax: 50]
'WORKER' task.wait

task 'WORKER' start with [wName: "W4" wMin: 10 wMax: 50]
'WORKER' task.wait

"Programme terminé" ?
