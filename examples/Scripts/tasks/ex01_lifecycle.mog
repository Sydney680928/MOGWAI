# ex01_lifecycle.mog
# Comprendre le cycle de vie d'une tâche enfant et les événements associés.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    "TASK DID START {! eventData}" eval ?
    "La tâche travaille..." ?
    "" ?
}

onEvent 'TASK_DID_END' do
{
    "TASK DID END {! eventData}" eval ?
    "La tâche est terminée." ?
    "" ?
}

task 'T1' do 
{
    # On récupère le paramètre passé lors de démarrage de la tâche
    -> 'message'

    # On simule un traitement
    3000 wait

    # On affecte le paramètre initial au résultat de la tâche
    message  task.setResult
}

task 'T1' start with "HELLO WORLD !"

'T1' task.wait

"Programme terminé" ?
