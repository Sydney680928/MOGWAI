# ex01_lifecycle.mog
# Understand the lifecycle of a child task and its associated events.

mogwai.reset
console.clear

onEvent 'TASK_DID_START' do
{
    "TASK DID START {! eventData}" eval ?
    "Task is running..." ?
    "" ?
}

onEvent 'TASK_DID_END' do
{
    "TASK DID END {! eventData}" eval ?
    "Task completed." ?
    "" ?
}

task 'T1' do 
{
    # Retrieve the parameter passed at task startup
    -> 'message'

    # Simulate a processing operation
    3000 wait

    # Set the initial parameter as the task result
    message  task.setResult
}

task 'T1' start with "HELLO WORLD !"

'T1' task.wait

"Program completed" ?
