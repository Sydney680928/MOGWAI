<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MogwaiPlayground</RootNamespace>
    <!-- Nécessaire pour GitHub Pages si le repo n'est pas à la racine -->
    <!-- <StaticWebAssetBasePath>/mogwai-playground</StaticWebAssetBasePath> -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.0" PrivateAssets="all" />
    <PackageReference Include="MOGWAI" Version="8.5.0" />
  </ItemGroup>

</Project>
