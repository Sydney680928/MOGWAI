@page "/"
@using MOGWAI.Engine
@using MOGWAI.Interfaces
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>MOGWAI Playground</PageTitle>

<div class="terminal-wrapper">

    <!-- ── En-tête ── -->
    <header class="terminal-header">
        <div class="header-left">
            <span class="logo-bracket">[</span>
            <span class="logo-text">MOGWAI</span>
            <span class="logo-bracket">]</span>
            <span class="logo-sub">Playground</span>
        </div>
        <div class="header-right">
            <a href="https://github.com/Sydney680928/mogwai" target="_blank" class="header-link">GitHub</a>
            <a href="https://www.nuget.org/packages/MOGWAI/" target="_blank" class="header-link">NuGet</a>
        </div>
    </header>

    @if (_editorMode)
    {
        <!-- ── Panneau éditeur ── -->
        <div class="editor-panel">

            <!-- InputFile caché, déclenché par le bouton Load -->
            <InputFile id="mogwai-file-input" OnChange="OnFileLoaded" accept=".mog,.txt" style="display:none" />

            <div class="editor-toolbar">
                <span class="editor-title">── EDITOR ──</span>
                <span class="editor-hint">Tab = indent  •  Ctrl+Enter = Run  @(_currentFileName != "script.mog" ? $"  •  {_currentFileName}" : "")</span>
                <div class="editor-actions">
                    <button class="editor-btn editor-btn-load" @onclick="TriggerFileLoad" disabled="@_isRunning" title="Load a .mog file">&#x1F4C2; Load</button>
                    <button class="editor-btn editor-btn-save" @onclick="SaveFile" disabled="@_isRunning" title="Save (Ctrl+S)">&#x1F4BE; Save</button>
                    <button class="editor-btn editor-btn-saveas" @onclick="SaveFileAs" disabled="@_isRunning" title="Save As...">&#x1F4BE;&#x2026; Save As</button>
                    <button class="editor-btn editor-btn-run" @onclick="RunFromEditor" disabled="@_isRunning">&#x25B6; Run</button>
                    <button class="editor-btn editor-btn-close" @onclick="CloseEditor" disabled="@_isRunning">&#x2715; Close</button>
                </div>
            </div>
            @if (_confirmOverwrite)
            {
                <div class="editor-confirm-bar">
                    <span class="editor-confirm-msg">&#x26A0; Buffer not empty — load example and overwrite?</span>
                    <button class="editor-btn editor-btn-confirm-yes" @onclick="ConfirmLoadExample">Yes, overwrite</button>
                    <button class="editor-btn editor-btn-confirm-no" @onclick="CancelLoadExample">Cancel</button>
                </div>
            }
            <textarea @ref="_editorRef"
                      @bind="_editorCode"
                      @bind:event="oninput"
                      @onkeydown="OnEditorKeyDown"
                      class="editor-textarea"
                      spellcheck="false"
                      autocomplete="off"
                      autocorrect="off"
                      autocapitalize="off"
                      placeholder="# Write your MOGWAI code here..."></textarea>
        </div>

        @if (_isRunning)
        {
            <div class="editor-running">
                <span class="spinner">&#x28CB;</span> Running...
            </div>
        }
    }
    else
    {
        <!-- ── Corps du terminal ── -->
        <div class="terminal-body" @ref="_terminalBody">
            @foreach (var line in _lines)
            {
                @switch (line.Kind)
                {
                    case LineKind.Input:
                        <div class="line line-input"><span class="prompt-sign">&#x276F;</span> @line.Text</div>
                        break;
                    case LineKind.Error:
                        <div class="line line-error">@line.Text</div>
                        break;
                    case LineKind.System:
                        <div class="line line-system">@line.Text</div>
                        break;
                    default:
                        <div class="line line-output">@line.Text</div>
                        break;
                }
            }

            @if (_isRunning)
            {
                <div class="line line-system">
                    <span class="spinner">&#x28CB;</span> Running...
                </div>
            }
        </div>

        <!-- ── Barre d'input ── -->
        <div class="terminal-input-bar">
            <span class="prompt-sign">&#x276F;</span>
            <input @ref="_inputRef"
                   @bind="_currentInput"
                   @bind:event="oninput"
                   @onkeydown="OnKeyDown"
                   class="terminal-input"
                   placeholder="Type MOGWAI code here — or type 'edit' to open the editor..."
                   spellcheck="false"
                   autocomplete="off"
                   autocorrect="off"
                   autocapitalize="off"
                   disabled="@_isRunning" />
        </div>

        <!-- ── Exemples cliquables ── -->
        <div class="examples-bar">
            <span class="examples-label">Examples :</span>
            @foreach (var ex in _examples)
            {
                <button class="example-btn" @onclick="() => LoadExampleInEditor(ex.Code)" title="@ex.Description">
                    @ex.Label
                </button>
            }
            <button class="example-btn example-btn-editor" @onclick="OpenEditor">&#x270E; Edit</button>
            <button class="example-btn example-btn-halt" @onclick="Halt">HALT</button>
            <button class="example-btn example-btn-clear" @onclick="ClearTerminal">&#x232B; Clear</button>
        </div>
    }

</div>

@code {

    // ── DOM References ──────────────────────────────────────

    private ElementReference _terminalBody;
    private ElementReference _inputRef;
    private ElementReference _editorRef;

    // ── State ───────────────────────────────────────────────

    private List<TerminalLine> _lines = new();
    private string _currentInput = string.Empty;
    private bool _isRunning = false;

    // ── Editor ──────────────────────────────────────────────

    private bool _editorMode = false;
    private string _editorCode = string.Empty;

    // Pending example load (overwrite confirmation)
    private bool _confirmOverwrite = false;
    private string _pendingCode = string.Empty;
    private string _currentFileName = "script.mog";
    private string _pendingFileName = string.Empty;

    // ── Command history ─────────────────────────────────────

    private List<string> _history = new();
    private int _historyIndex = -1;

    // ── MOGWAI engine ───────────────────────────────────────

    private MogwaiEngine? _engine;
    private MogwaiDelegate? _delegate;

    // ── Examples ────────────────────────────────────────────

    private readonly (string Label, string Description, string Code)[] _examples =
    [
    ("Hello World",  "Display a message",                      "\"Hello, MOGWAI!\" ?"),
    ("Arithmetic",   "RPN calculation: (2 + 3) x 4",           "2 3 + 4 * ?"),
    ("Variable",     "Store and reuse a value",                "42 -> 'x'\nx 2 * ?"),
    ("Loop",         "Print 1 to 5",                           "1 5 for 'i' do\n{\n\ti ?\n}\n"),
    ("Fibonacci",    "Recursive Fibonacci",                    "to 'fib' do\n{\n\tdup\n\n\tif (2 <) then\n\t{\n\t\treturn\n\t}\n\n\tdup 1 - fib swap 2 - fib +\n}\n\n0 fib ?\n\n1 fib ?\n\n5 fib ?\n\n10 fib ?\n\n"),
    ("Stack",        "Stack manipulations",                    "1 2 3  depth ?\n\nswap ?\n\ndrop\n\n"),
    ("Strings",      "String operations",                      "\"mogwai\" dup size ?\n\n->upper ?\n\n"),
    ("List",         "Create and iterate a list",              "(10 20 30 40 50) -> '$lst'\n\n$lst size ?\n\n$lst 2 get ?\n\n"),
];

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await Task.CompletedTask;

        _delegate = new MogwaiDelegate();
        _delegate.OnOutput += OnEngineOutput;
        _delegate.PromptHandler = HandlePrompt;

        _engine = new MogwaiEngine("MOGWAI Playground", keepAlive: true, useDefaultFolders: false);
        _engine.Delegate = _delegate;

        PrintWelcome();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusInput();
        }
        if (_editorMode)
        {
            await JS.InvokeVoidAsync("mogwaiEditor.focus", _editorRef);
        }
        else
        {
            await ScrollToBottom();
        }
    }

    public void Dispose()
    {
        if (_delegate is not null)
            _delegate.OnOutput -= OnEngineOutput;
    }

    // ── Engine output ─────────────────────────────────────────────

    private void OnEngineOutput(TerminalLine line)
    {
        if (line.Kind == LineKind.Clear)
        {
            _lines.Clear();
        }
        else
        {
            _lines.Add(line);
        }
        InvokeAsync(StateHasChanged);
    }

    // ── Terminal input ────────────────────────────────────────────

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await ExecuteCurrentInput();
                break;

            case "ArrowUp":
                NavigateHistory(-1);
                break;

            case "ArrowDown":
                NavigateHistory(+1);
                break;
        }
    }

    private async Task ExecuteCurrentInput()
    {
        var code = _currentInput.Trim();
        if (string.IsNullOrEmpty(code) || _engine is null) return;

        // ── Intercept built-in commands ──
        if (code.Equals("edit", StringComparison.OrdinalIgnoreCase))
        {
            _currentInput = string.Empty;
            OpenEditor();
            return;
        }

        _history.Insert(0, code);
        _historyIndex = -1;

        _lines.Add(new TerminalLine(code, LineKind.Input));
        _currentInput = string.Empty;

        _isRunning = true;
        StateHasChanged();

        try
        {
            var result = await _engine.RunAsync(code, debugMode: false);

            if (result.IsError)
            {
                _lines.Add(new TerminalLine($"⚠ {result}", LineKind.Error));
            }
            else
            {
                _lines.Add(new TerminalLine($"✓ {result}", LineKind.System));
            }
        }
        catch (Exception ex)
        {
            _lines.Add(new TerminalLine($"⚠ Exception : {ex.Message}", LineKind.Error));
        }
        finally
        {
            _isRunning = false;
            StateHasChanged();
            await FocusInput();
        }
    }

    private void NavigateHistory(int direction)
    {
        if (_history.Count == 0) return;

        _historyIndex = Math.Clamp(_historyIndex + direction, -1, _history.Count - 1);
        _currentInput = _historyIndex >= 0 ? _history[_historyIndex] : string.Empty;
        StateHasChanged();
    }

    private void LoadExampleInEditor(string code)
    {
        _pendingCode = code;

        if (!string.IsNullOrWhiteSpace(_editorCode) && !_editorMode)
        {
            // Buffer has content but editor is closed — open editor and ask
            _editorMode = true;
            _confirmOverwrite = true;
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrWhiteSpace(_editorCode) && _editorMode)
        {
            // Editor already open with content — ask
            _confirmOverwrite = true;
            StateHasChanged();
            return;
        }

        // Buffer empty — load directly
        _editorCode = code;
        _editorMode = true;
        _confirmOverwrite = false;
        StateHasChanged();
    }

    private void ConfirmLoadExample()
    {
        _editorCode = _pendingCode;
        _pendingCode = string.Empty;
        if (!string.IsNullOrEmpty(_pendingFileName))
        {
            _currentFileName = _pendingFileName;
            _pendingFileName = string.Empty;
        }
        _confirmOverwrite = false;
        StateHasChanged();
    }

    private void CancelLoadExample()
    {
        _pendingCode = string.Empty;
        _pendingFileName = string.Empty;
        _confirmOverwrite = false;
        StateHasChanged();
    }

    // ── Load / Save ───────────────────────────────────────

    // Result record for File System Access API open dialog
    private record FileLoadResult(string Name, string Content);

    private async Task TriggerFileLoad()
    {
        var hasApi = await JS.InvokeAsync<bool>("mogwaiEditor.hasFileSystemAccess");
        if (hasApi)
        {
            // Chrome/Edge : vraie boîte "Ouvrir"
            var result = await JS.InvokeAsync<FileLoadResult?>("mogwaiEditor.openFile");
            if (result is not null)
            {
                await JS.InvokeVoidAsync("mogwaiEditor.clearFileHandle");
                await QueueFileContent(result.Name, result.Content);
            }
        }
        else
        {
            // Firefox/Safari : fallback InputFile
            await JS.InvokeVoidAsync("mogwaiEditor.triggerFileInput");
        }
    }

    private async Task OnFileLoaded(InputFileChangeEventArgs e)
    {
        // Fallback path (Firefox/Safari) via <InputFile>
        var file = e.File;
        if (file is null) return;

        using var reader = new System.IO.StreamReader(file.OpenReadStream(maxAllowedSize: 1_048_576));
        var text = await reader.ReadToEndAsync();

        await JS.InvokeVoidAsync("mogwaiEditor.clearFileHandle");
        await QueueFileContent(file.Name, text);
    }

    private Task QueueFileContent(string name, string text)
    {
        _pendingFileName = name;
        _pendingCode     = text;

        if (!string.IsNullOrWhiteSpace(_editorCode))
        {
            _confirmOverwrite = true;
        }
        else
        {
            _editorCode       = text;
            _currentFileName  = name;
            _pendingFileName  = string.Empty;
            _pendingCode      = string.Empty;
            _confirmOverwrite = false;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SaveFile()
    {
        if (string.IsNullOrEmpty(_editorCode)) return;
        await JS.InvokeVoidAsync("mogwaiEditor.saveFile", _currentFileName, _editorCode);
    }

    private async Task SaveFileAs()
    {
        if (string.IsNullOrEmpty(_editorCode)) return;
        var newName = await JS.InvokeAsync<string?>("mogwaiEditor.saveFileAs", _currentFileName, _editorCode);
        if (!string.IsNullOrEmpty(newName))
        {
            _currentFileName = newName;
            StateHasChanged();
        }
    }

    private void ClearTerminal()
    {
        _lines.Clear();
        StateHasChanged();
    }

    private void Halt()
    {
        _engine?.Halt();
        StateHasChanged();
    }

    // ── Editor ────────────────────────────────────────────────────

    private void OpenEditor()
    {
        _editorMode = true;
        StateHasChanged();
    }

    private async Task CloseEditor()
    {
        await JS.InvokeVoidAsync("mogwaiEditor.detach", _editorRef);
        _editorMode = false;
        _confirmOverwrite = false;
        _pendingCode = string.Empty;
        _lines.Add(new TerminalLine("Editor closed — buffer preserved. Type 'edit' to reopen.", LineKind.System));
        StateHasChanged();
    }

    private async Task RunFromEditor()
    {
        var code = _editorCode.Trim();
        if (string.IsNullOrEmpty(code) || _engine is null) return;

        _isRunning = true;
        _confirmOverwrite = false;
        _pendingCode = string.Empty;
        await JS.InvokeVoidAsync("mogwaiEditor.detach", _editorRef);
        _editorMode = false;
        StateHasChanged();

        _lines.Add(new TerminalLine("▶ Running editor buffer...", LineKind.System));
        StateHasChanged();

        try
        {
            var result = await _engine.RunAsync(code, debugMode: false);

            if (result.IsError)
            {
                _lines.Add(new TerminalLine($"⚠ {result}", LineKind.Error));
            }
            else
            {
                _lines.Add(new TerminalLine($"✓ {result}", LineKind.System));
            }
        }
        catch (Exception ex)
        {
            _lines.Add(new TerminalLine($"⚠ Exception : {ex.Message}", LineKind.Error));
        }
        finally
        {
            _isRunning = false;
            StateHasChanged();
            await FocusInput();
        }
    }

    private async Task OnEditorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
        {
            await RunFromEditor();
            return;
        }

        // Tab is handled entirely by the JS listener attached in mogwaiEditor.focus()
    }

    // ── Prompt (INPUT MOGWAI) ────────────────────────────────────

    private async Task<string?> HandlePrompt(string message)
    {
        return await JS.InvokeAsync<string?>("prompt", message);
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private void PrintWelcome()
    {
        var lines = new[]
        {
            "╔══════════════════════════════════╗",
            "║        MOGWAI PLAYGROUND         ║",
            "║ Stack-based scripting for .NET   ║",
            "╚══════════════════════════════════╝",
            "",
            "  Type MOGWAI code and press Enter.",
            "  Use ↑ ↓ to navigate through history.",
            "  Click an example to run it.",
            "  Type 'edit' or click ✎ Edit to open the multi-line editor.",
            "",
            "  💡 Variables prefixed with $ are global and",
            "     persist between commands (e.g. 42 -> '$x').",
            "     Local variables are reset after each execution.",
            "",
        };
        foreach (var l in lines)
            _lines.Add(new TerminalLine(l, LineKind.System));
    }

    private async Task ScrollToBottom()
    {
        await JS.InvokeVoidAsync("mogwaiTerminal.scrollToBottom", _terminalBody);
    }

    private async Task FocusInput()
    {
        await _inputRef.FocusAsync();
    }
}
